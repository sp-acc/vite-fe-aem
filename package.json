{
  "name": "vite-aem-fe-build",
  "version": "0.1.0",
  "description": "Vite-based frontend build tool for AEM projects. Drop-in replacement for @netcentric/fe-build.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sp-acc/vite-aem-fe-build.git"
  },
  "bin": {
    "vite-aem-fe-build": "bin/index.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf ./tests/fixtures/dist* ./tests/.parity",
