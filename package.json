  "keywords": [
    "aem",
    "vite",
    "build",
    "clientlibs"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "chokidar": "^4.0.3",
    "eslint": "^9.0.0",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.1",
    "sass": "^1.83.4",
    "stylelint": "^16.14.1",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "jquery": "^3.7.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "vitest": "^3.0.0"
  }
}
